meta {
  name: Top up a wallet
  type: http
  seq: 6
  tags: [
    wallets
  ]
}

post {
  url: {{baseUrl}}/api/v1/wallets/topup
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    
  "walletId": 1,
  "amount": 1000,
  "idempotencyKey": "unique-key-123"
  }
}

example {
  name: 200 Response
  description: Wallet topped up successfully
  
  request: {
    url: {{baseUrl}}/api/v1/wallets/topup
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      "walletId": "sample-wallet-id",
      "amount": 1000,
      "idempotencyKey": "unique-key-123"
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 1,
          "ownerId": 1,
          "currency": "USD",
          "balance": "0.00",
          "status": "ACTIVE"
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid request body
  
  request: {
    url: {{baseUrl}}/api/v1/wallets/topup
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
