meta {
  name: Retrieve a wallet by ID
  type: http
  seq: 3
  tags: [
    wallets
  ]
}

get {
  url: {{baseUrl}}/api/v1/wallets/:id
  body: none
  auth: inherit
}

params:path {
  id: 
}

example {
  name: 200 Response
  description: Wallet found
  
  request: {
    url: {{baseUrl}}/api/v1/wallets/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 1,
          "ownerId": 1,
          "currency": "USD",
          "balance": "0.00",
          "status": "ACTIVE"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Wallet not found
  
  request: {
    url: {{baseUrl}}/api/v1/wallets/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
