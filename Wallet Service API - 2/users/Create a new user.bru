meta {
  name: Create a new user
  type: http
  seq: 1
  tags: [
    users
  ]
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: inherit
}

body:json {
  {
    "email": "user1@example.com",
    "name": "John Doe"
  }
}

example {
  name: 201 Response
  description: User created successfully
  
  request: {
    url: {{baseUrl}}/api/v1/users
    method: POST
    mode: json
    body:json: {
      {
        "email": "user@example.com",
        "name": "John Doe"
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid request body
  
  request: {
    url: {{baseUrl}}/api/v1/users
    method: POST
    mode: json
    body:json: {
      {
        "email": "user@example.com",
        "name": "John Doe"
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
