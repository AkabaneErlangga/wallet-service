meta {
  name: Retrieve all wallets
  type: http
  seq: 2
  tags: [
    wallets
  ]
}

get {
  url: {{baseUrl}}/api/v1/wallets
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

example {
  name: 200 Response
  description: List of wallets
  
  request: {
    url: {{baseUrl}}/api/v1/wallets
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 1,
            "ownerId": 1,
            "currency": "USD",
            "balance": "0.00",
            "status": "ACTIVE"
          }
        ]
      '''
    }
  }
}
